{
  "$id": "https://marscompute.ai/schemas/xtrace/upload-begin.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "cubin",
        "safetensors",
        "launch_manifest",
        "source",
        "reference",
        "xtrace",
        "summary",
        "provenance",
        "trace_plan",
        "baseline",
        "correctness",
        "runner_log",
        "range_profile",
        "pc_sampling",
        "interpretation",
        "comparison",
        "kernel_metadata",
        "workspace_file"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
    },
    "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1099511627776 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "content_type": { "type": "string", "minLength": 1, "maxLength": 200 },
    "resume_artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  },
  "required": ["kind", "size_bytes", "sha256", "content_type"],
  "additionalProperties": false
}
