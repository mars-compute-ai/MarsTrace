{
  "$id": "https://marscompute.ai/schemas/xtrace/inspection-downloads-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "artifact_ids": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    }
  },
  "required": ["artifact_ids"],
  "additionalProperties": false
}
