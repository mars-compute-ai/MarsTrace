{
  "$id": "https://marscompute.ai/schemas/xtrace/credit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "available_micro_usd": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,29})$"
    },
    "reserved_micro_usd": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,29})$"
    },
    "top_up_url": { "type": "string", "format": "uri" }
  },
  "required": ["available_micro_usd", "reserved_micro_usd", "top_up_url"],
  "additionalProperties": false
}
