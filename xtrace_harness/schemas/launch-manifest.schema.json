{
  "$id": "https://marscompute.ai/schemas/xtrace/launch-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "marscompute.kernel-launch"
    },
    "target": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "string",
          "enum": [
            "sm_80",
            "sm_86",
            "sm_89",
            "sm_90",
            "sm_90a",
            "sm_100",
            "sm_100a",
            "sm_103",
            "sm_103a"
          ]
        },
        "kernel_symbol": { "type": "string" },
        "grid": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "integer", "minimum": 1, "maximum": 65535 }
          ]
        },
        "block": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1, "maximum": 1024 },
            { "type": "integer", "minimum": 1, "maximum": 1024 },
            { "type": "integer", "minimum": 1, "maximum": 64 }
          ]
        },
        "cluster": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                { "type": "integer", "minimum": 1, "maximum": 4294967295 },
                { "type": "integer", "minimum": 1, "maximum": 4294967295 },
                { "type": "integer", "minimum": 1, "maximum": 4294967295 }
              ]
            },
            { "type": "null" }
          ]
        },
        "dynamic_shared_memory_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 233472
        }
      },
      "required": [
        "architecture",
        "kernel_symbol",
        "grid",
        "block",
        "cluster",
        "dynamic_shared_memory_bytes"
      ],
      "additionalProperties": false
    },
    "parameter_layout": {
      "anyOf": [
        {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "offset": { "type": "integer", "minimum": 0, "maximum": 4095 },
              "size_bytes": { "type": "integer", "minimum": 1, "maximum": 4096 }
            },
            "required": ["index", "offset", "size_bytes"],
            "additionalProperties": false
          }
        },
        { "type": "null" }
      ]
    },
    "allocations": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "init": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "zeros" }
                },
                "required": ["kind"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "tensor" },
                  "tensor_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
                  }
                },
                "required": ["kind", "tensor_key"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["id", "size_bytes", "init"],
        "additionalProperties": false
      }
    },
    "buffers": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
          },
          "allocation_id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
          },
          "offset_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "access": {
            "type": "string",
            "enum": ["read", "write", "read_write"]
          }
        },
        "required": [
          "name",
          "allocation_id",
          "offset_bytes",
          "size_bytes",
          "access"
        ],
        "additionalProperties": false
      }
    },
    "arguments": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": { "type": "string", "const": "scalar" },
              "abi_type": {
                "type": "string",
                "enum": [
                  "int8",
                  "uint8",
                  "int16",
                  "uint16",
                  "int32",
                  "uint32",
                  "int64",
                  "uint64",
                  "float32",
                  "float64"
                ]
              },
              "value": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "required": ["index", "kind", "abi_type", "value"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": { "type": "string", "const": "buffer" },
              "buffer": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
              },
              "offset_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["index", "kind", "buffer", "offset_bytes"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": { "type": "string", "const": "bytes" },
              "hex": { "type": "string", "pattern": "^([a-f0-9]{2})+$" },
              "relocations": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "offset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "buffer": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "offset_bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["offset", "buffer", "offset_bytes"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["index", "kind", "hex", "relocations"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": { "type": "string", "const": "tensor_map" },
              "buffer": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
              },
              "offset_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "data_type": {
                "type": "string",
                "enum": [
                  "u8",
                  "u16",
                  "u32",
                  "i32",
                  "u64",
                  "i64",
                  "f16",
                  "f32",
                  "f64",
                  "bf16",
                  "f32_ftz",
                  "tf32",
                  "tf32_ftz"
                ]
              },
              "global_dims": {
                "minItems": 1,
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967296
                }
              },
              "global_strides_bytes": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "box_dims": {
                "maxItems": 5,
                "type": "array",
                "items": { "type": "integer", "minimum": 1, "maximum": 256 }
              },
              "element_strides": {
                "maxItems": 5,
                "type": "array",
                "items": { "type": "integer", "minimum": 1, "maximum": 8 }
              },
              "interleave": {
                "type": "string",
                "enum": ["none", "16b", "32b"]
              },
              "swizzle": {
                "type": "string",
                "enum": ["none", "32b", "64b", "128b"]
              },
              "l2_promotion": {
                "type": "string",
                "enum": ["none", "64b", "128b", "256b"]
              },
              "oob_fill": { "type": "string", "enum": ["none", "nan"] }
            },
            "required": [
              "index",
              "kind",
              "buffer",
              "offset_bytes",
              "data_type",
              "global_dims",
              "global_strides_bytes",
              "box_dims",
              "element_strides",
              "interleave",
              "swizzle",
              "l2_promotion",
              "oob_fill"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": { "type": "string", "const": "runtime" },
              "binding_key": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "required": ["index", "kind", "binding_key"],
            "additionalProperties": false
          }
        ]
      }
    },
    "outputs": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
          },
          "buffer": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
          },
          "dtype": {
            "type": "string",
            "enum": [
              "bool",
              "uint8",
              "int8",
              "int16",
              "uint16",
              "int32",
              "uint32",
              "int64",
              "uint64",
              "float16",
              "bfloat16",
              "float32",
              "float64"
            ]
          },
          "shape": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "required": ["name", "buffer", "dtype", "shape"],
        "additionalProperties": false
      }
    },
    "runtime_profile": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "profile_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[\\x21-\\x7e]{1,128}$"
            },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "required": ["profile_id", "revision", "sha256"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "reset": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "restore_pristine_before_every_invocation"
        }
      },
      "required": ["policy"],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "output_key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
        },
        "reference_key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
        },
        "reference_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "atol": { "type": "number", "minimum": 0, "maximum": 1 },
        "rtol": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["output_key", "atol", "rtol"],
      "additionalProperties": false
    },
    "reproduction": {
      "type": "object",
      "properties": {
        "warmup": { "type": "integer", "minimum": 0, "maximum": 100 },
        "repeats": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "required": ["warmup", "repeats", "seed"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "target",
    "parameter_layout",
    "allocations",
    "buffers",
    "arguments",
    "outputs",
    "runtime_profile",
    "reset"
  ],
  "additionalProperties": false
}
