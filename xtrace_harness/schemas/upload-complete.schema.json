{
  "$id": "https://marscompute.ai/schemas/xtrace/upload-complete.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1099511627776 },
    "parts": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_number": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "etag": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "required": ["part_number", "etag"],
        "additionalProperties": false
      }
    }
  },
  "required": ["sha256", "size_bytes"],
  "additionalProperties": false
}
