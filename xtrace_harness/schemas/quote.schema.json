{
  "$id": "https://marscompute.ai/schemas/xtrace/quote.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "optimization_session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "request_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_digests": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["artifact_id", "sha256"],
        "additionalProperties": false
      }
    },
    "compute": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["nebius", "lambda"] },
        "region": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "gpu_type": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "gpu_count": { "type": "integer", "minimum": 0, "maximum": 64 },
        "purchase_option": { "type": "string", "enum": ["spot", "on_demand"] },
        "fallback": { "type": "string", "enum": ["none", "quoted_only"] }
      },
      "required": [
        "provider",
        "region",
        "gpu_type",
        "gpu_count",
        "purchase_option",
        "fallback"
      ],
      "additionalProperties": false
    },
    "permitted_fallbacks": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": { "type": "string", "enum": ["nebius", "lambda"] },
          "region": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "gpu_type": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "gpu_count": { "type": "integer", "minimum": 0, "maximum": 64 },
          "purchase_option": {
            "type": "string",
            "enum": ["spot", "on_demand"]
          },
          "fallback": { "type": "string", "enum": ["none", "quoted_only"] }
        },
        "required": [
          "provider",
          "region",
          "gpu_type",
          "gpu_count",
          "purchase_option",
          "fallback"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_total_cost_micro_usd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,29})$"
        },
        "max_active_gpu_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 172800
        },
        "max_attempts": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_trace_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        }
      },
      "required": [
        "max_total_cost_micro_usd",
        "max_active_gpu_seconds",
        "max_wall_seconds",
        "max_attempts",
        "max_trace_bytes"
      ],
      "additionalProperties": false
    },
    "rate_snapshot": {
      "type": "object",
      "properties": {
        "rate_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "sku_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "gpu_micro_usd_per_hour": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,29})$"
        },
        "failure_policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "gpu_time_policy": {
          "type": "string",
          "const": "authorized_execution_only"
        },
        "model_rates": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "price_snapshot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "input_micro_usd_per_million": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,29})$"
              },
              "cached_input_micro_usd_per_million": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,29})$"
              },
              "output_micro_usd_per_million": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,29})$"
              }
            },
            "required": [
              "model",
              "price_snapshot_id",
              "input_micro_usd_per_million",
              "cached_input_micro_usd_per_million",
              "output_micro_usd_per_million"
            ],
            "additionalProperties": false
          }
        },
        "price_book": {
          "type": "object",
          "properties": {
            "rate_card_version_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "tool_fee_micro_usd": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,29})$"
            },
            "cache_write_rates": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dimension": {
                    "type": "string",
                    "pattern": "^cache_write_[1-9][0-9]{0,7}_(explicit|implicit)_tokens$"
                  },
                  "micro_usd_per_million": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,29})$"
                  }
                },
                "required": ["dimension", "micro_usd_per_million"],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "rate_card_version_id",
            "tool_fee_micro_usd",
            "cache_write_rates"
          ],
          "additionalProperties": false
        },
        "workspace_image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "rate_version",
        "sku_id",
        "image_digest",
        "gpu_micro_usd_per_hour",
        "failure_policy_version",
        "gpu_time_policy",
        "model_rates"
      ],
      "additionalProperties": false
    },
    "planner_data_path": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "marscompute.xtrace.planner-data-path.v1"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "disclosure_classes": {
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "user_prompt",
              "kernel_identity",
              "launch_geometry",
              "instruction_and_register_metadata",
              "planning_limits",
              "artifact_identifiers_and_digests",
              "comparison_layout_correctness_and_timing"
            ]
          }
        },
        "primary_path": {
          "type": "object",
          "properties": {
            "path_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "provider_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "provider_model_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "processing_regions": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "retention": {
              "type": "object",
              "properties": {
                "policy_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "disclosure": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": ["policy_id", "revision", "disclosure"],
              "additionalProperties": false
            },
            "transport_binding_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path_id",
            "provider_id",
            "provider_model_id",
            "processing_regions",
            "retention",
            "transport_binding_sha256"
          ],
          "additionalProperties": false
        },
        "fallback_paths": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "provider_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "provider_model_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "processing_regions": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                }
              },
              "retention": {
                "type": "object",
                "properties": {
                  "policy_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "disclosure": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": ["policy_id", "revision", "disclosure"],
                "additionalProperties": false
              },
              "transport_binding_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path_id",
              "provider_id",
              "provider_model_id",
              "processing_regions",
              "retention",
              "transport_binding_sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "policy_id",
        "policy_revision",
        "policy_sha256",
        "model",
        "disclosure_classes",
        "primary_path",
        "fallback_paths"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "quote_id",
    "request_hash",
    "input_digests",
    "compute",
    "permitted_fallbacks",
    "limits",
    "rate_snapshot",
    "created_at",
    "expires_at"
  ],
  "additionalProperties": false
}
