{
  "$id": "https://marscompute.ai/schemas/xtrace/result-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "marscompute.xtrace.result.v1"
    },
    "kind": { "type": "string", "const": "agent" },
    "diagnostic_stages": {
      "type": "object",
      "properties": {
        "kernel": {
          "minItems": 1,
          "maxItems": 1,
          "type": "array",
          "items": { "type": "string", "const": "xtrace" }
        }
      },
      "required": ["kernel"],
      "additionalProperties": false
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "publication_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "status": { "type": "string", "enum": ["complete", "partial"] },
    "evidence": { "type": "string", "enum": ["gpu", "synthetic"] },
    "quality": { "type": "string", "enum": ["usable", "partial", "unusable"] },
    "reason_codes": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "correctness": {
      "type": "string",
      "enum": ["passed", "failed", "not_verified"]
    },
    "files": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "cubin",
              "safetensors",
              "launch_manifest",
              "source",
              "xtrace",
              "workspace_file"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "content_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "encoding": { "type": "string", "enum": ["identity", "gzip"] },
          "uncompressed_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uncompressed_size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "sha256",
          "size_bytes",
          "content_type",
          "encoding"
        ],
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "gpu_type": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "workspace_image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "driver_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "cuda_version": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "workspace_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "executor_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\+[0-9a-f]{7,40})?$"
        },
        "clock_type": {
          "type": "string",
          "enum": ["sm_cycles", "globaltimer_ns", "unknown"]
        },
        "record_granularity": { "type": "string", "enum": ["thread", "warp"] },
        "observer_effect": { "type": "string", "enum": ["measured", "unknown"] }
      },
      "required": [
        "gpu_type",
        "architecture",
        "workspace_image_digest",
        "driver_version",
        "cuda_version",
        "workspace_version",
        "executor_version",
        "clock_type",
        "record_granularity",
        "observer_effect"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "job_id",
    "attempt_id",
    "epoch",
    "publication_version",
    "published_at",
    "status",
    "evidence",
    "quality",
    "reason_codes",
    "correctness",
    "files",
    "environment"
  ],
  "additionalProperties": false
}
