{
  "$id": "https://marscompute.ai/schemas/xtrace/submit-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "marscompute.xtrace.submit.v1"
    },
    "optimization_session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 32000 },
    "bundle": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "cubin_launch" },
            "cubin_artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "tensors_artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "manifest_artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "reference_artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": ["kind", "cubin_artifact_id", "manifest_artifact_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "source_recipe" },
            "source_artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "tensors_artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "manifest_artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "reference_artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "template_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "language": {
              "type": "string",
              "enum": ["cuda", "triton", "cute", "tilelang"]
            },
            "compiler_flags": {
              "maxItems": 64,
              "type": "array",
              "items": { "type": "string", "maxLength": 200 }
            }
          },
          "required": [
            "kind",
            "source_artifact_id",
            "manifest_artifact_id",
            "template_id",
            "language",
            "compiler_flags"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "comparison" },
            "baseline": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": { "type": "string", "const": "cubin_launch" },
                    "cubin_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "tensors_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "manifest_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "reference_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    }
                  },
                  "required": [
                    "kind",
                    "cubin_artifact_id",
                    "manifest_artifact_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": { "type": "string", "const": "source_recipe" },
                    "source_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "tensors_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "manifest_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "reference_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "template_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "language": {
                      "type": "string",
                      "enum": ["cuda", "triton", "cute", "tilelang"]
                    },
                    "compiler_flags": {
                      "maxItems": 64,
                      "type": "array",
                      "items": { "type": "string", "maxLength": 200 }
                    }
                  },
                  "required": [
                    "kind",
                    "source_artifact_id",
                    "manifest_artifact_id",
                    "template_id",
                    "language",
                    "compiler_flags"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "candidate": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": { "type": "string", "const": "cubin_launch" },
                    "cubin_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "tensors_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "manifest_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "reference_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    }
                  },
                  "required": [
                    "kind",
                    "cubin_artifact_id",
                    "manifest_artifact_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": { "type": "string", "const": "source_recipe" },
                    "source_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "tensors_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "manifest_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "reference_artifact_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "template_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "language": {
                      "type": "string",
                      "enum": ["cuda", "triton", "cute", "tilelang"]
                    },
                    "compiler_flags": {
                      "maxItems": 64,
                      "type": "array",
                      "items": { "type": "string", "maxLength": 200 }
                    }
                  },
                  "required": [
                    "kind",
                    "source_artifact_id",
                    "manifest_artifact_id",
                    "template_id",
                    "language",
                    "compiler_flags"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "require_correctness": { "type": "boolean", "const": true },
            "timing": {
              "type": "object",
              "properties": {
                "warmup": { "type": "integer", "minimum": 0, "maximum": 10000 },
                "repeats": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                }
              },
              "required": ["warmup", "repeats"],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "baseline",
            "candidate",
            "require_correctness",
            "timing"
          ],
          "additionalProperties": false
        }
      ]
    },
    "compute": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["nebius", "lambda"] },
        "region": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "gpu_type": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "gpu_count": { "type": "integer", "minimum": 0, "maximum": 64 },
        "purchase_option": { "type": "string", "enum": ["spot", "on_demand"] },
        "fallback": { "type": "string", "enum": ["none", "quoted_only"] }
      },
      "required": [
        "provider",
        "region",
        "gpu_type",
        "gpu_count",
        "purchase_option",
        "fallback"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "const": "explicit_plan" },
            "trace_plan": {
              "type": "object",
              "properties": {
                "tier": { "type": "string", "const": "sass" },
                "clock": { "type": "string", "enum": ["gpu", "sm", "anchor"] },
                "schedule": {
                  "type": "string",
                  "enum": ["first_feasible", "least_makespan"]
                },
                "sites": {
                  "maxItems": 4096,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "site_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[A-Za-z0-9_.:-]+$"
                      },
                      "instruction_index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "probe": {
                        "type": "string",
                        "enum": ["timing", "value", "smid"]
                      },
                      "value_register": {
                        "type": "string",
                        "pattern": "^(?:R(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-4])|UR(?:[0-9]|[1-5][0-9]|6[0-2]))$"
                      },
                      "value_width_bits": {
                        "anyOf": [
                          { "type": "number", "const": 32 },
                          { "type": "number", "const": 64 }
                        ]
                      }
                    },
                    "required": ["site_id", "instruction_index", "probe"],
                    "additionalProperties": false
                  }
                },
                "regions": {
                  "maxItems": 2048,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "region_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[A-Za-z0-9_.:-]+$"
                      },
                      "start_site_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[A-Za-z0-9_.:-]+$"
                      },
                      "end_site_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[A-Za-z0-9_.:-]+$"
                      }
                    },
                    "required": ["region_id", "start_site_id", "end_site_id"],
                    "additionalProperties": false
                  }
                },
                "scope_roles": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "granularity": { "type": "string", "enum": ["thread", "warp"] },
                "max_records": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "capture_values": { "type": "boolean" },
                "stages": {
                  "minItems": 1,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["xtrace", "range_profile", "pc_sampling"]
                  }
                },
                "range_profile": {
                  "type": "object",
                  "properties": {
                    "metrics": {
                      "minItems": 1,
                      "maxItems": 16,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
                      }
                    },
                    "max_invocations": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 128
                    }
                  },
                  "required": ["metrics", "max_invocations"],
                  "additionalProperties": false
                },
                "pc_sampling": {
                  "type": "object",
                  "properties": {
                    "repeats": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    }
                  },
                  "required": ["repeats"],
                  "additionalProperties": false
                }
              },
              "required": [
                "tier",
                "sites",
                "regions",
                "granularity",
                "max_records",
                "capture_values",
                "stages"
              ],
              "additionalProperties": false
            }
          },
          "required": ["mode", "trace_plan"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "const": "platform_planned" },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "max_calls": { "type": "integer", "minimum": 0, "maximum": 20 },
            "max_input_tokens_total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "max_output_tokens_total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "capture_values": { "default": false, "type": "boolean" }
          },
          "required": [
            "mode",
            "model",
            "max_calls",
            "max_input_tokens_total",
            "max_output_tokens_total"
          ],
          "additionalProperties": false
        }
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_total_cost_micro_usd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,29})$"
        },
        "max_active_gpu_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 172800
        },
        "max_attempts": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_trace_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        }
      },
      "required": [
        "max_total_cost_micro_usd",
        "max_active_gpu_seconds",
        "max_wall_seconds",
        "max_attempts",
        "max_trace_bytes"
      ],
      "additionalProperties": false
    },
    "quote_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "required": [
    "schema_version",
    "prompt",
    "bundle",
    "compute",
    "analysis",
    "limits",
    "quote_id"
  ],
  "additionalProperties": false
}
