{
  "$id": "https://marscompute.ai/schemas/xtrace/submit-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "marscompute.xtrace.submit.v1"
    },
    "optimization_session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 32000 },
    "bundle": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "const": "agent_workspace" },
        "cubin_artifact_ids": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "source_archive_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "launch_manifest_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "tensor_artifact_ids": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "file_artifact_ids": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        }
      },
      "required": [
        "kind",
        "cubin_artifact_ids",
        "tensor_artifact_ids",
        "file_artifact_ids"
      ],
      "additionalProperties": false
    },
    "compute": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["nebius", "lambda"] },
        "region": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "gpu_type": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "gpu_count": { "type": "integer", "minimum": 0, "maximum": 64 },
        "purchase_option": { "type": "string", "enum": ["spot", "on_demand"] },
        "fallback": { "type": "string", "enum": ["none", "quoted_only"] }
      },
      "required": [
        "provider",
        "region",
        "gpu_type",
        "gpu_count",
        "purchase_option",
        "fallback"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "const": "agent" },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "max_turns": { "type": "integer", "minimum": 0, "maximum": 500 },
        "max_input_tokens_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000000
        },
        "max_output_tokens_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2580
        }
      },
      "required": [
        "mode",
        "model",
        "max_turns",
        "max_input_tokens_total",
        "max_output_tokens_total",
        "max_wall_seconds"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_total_cost_micro_usd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,29})$"
        },
        "max_active_gpu_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 172800
        },
        "max_attempts": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_trace_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        }
      },
      "required": [
        "max_total_cost_micro_usd",
        "max_active_gpu_seconds",
        "max_wall_seconds",
        "max_attempts",
        "max_trace_bytes"
      ],
      "additionalProperties": false
    },
    "quote_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "required": [
    "schema_version",
    "prompt",
    "bundle",
    "compute",
    "analysis",
    "limits",
    "quote_id"
  ],
  "additionalProperties": false
}
