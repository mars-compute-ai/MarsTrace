{
  "$id": "https://marscompute.ai/schemas/xtrace/inspection-accept.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "marscompute.xtrace.inspection-accept.v1"
    },
    "quote_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "quote_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "marscompute.xtrace.inspection-request.v1"
        },
        "binary": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "size_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "format": { "type": "string", "const": "cubin" }
          },
          "required": ["artifact_id", "sha256", "size_bytes", "format"],
          "additionalProperties": false
        },
        "kernel_selector": {
          "oneOf": [
            {
              "type": "object",
              "properties": { "kind": { "type": "string", "const": "all" } },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "symbol" },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_.$]*$"
                }
              },
              "required": ["kind", "symbol"],
              "additionalProperties": false
            }
          ]
        },
        "inspection_profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "optimization_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "schema_version",
        "binary",
        "kernel_selector",
        "inspection_profile_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "quote_id",
    "quote_sha256",
    "idempotency_key",
    "request"
  ],
  "additionalProperties": false
}
