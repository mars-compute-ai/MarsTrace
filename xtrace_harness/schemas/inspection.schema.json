{
  "$id": "https://marscompute.ai/schemas/xtrace/inspection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "marscompute.xtrace.inspection-status.v1"
    },
    "inspection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "owner": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "account_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": ["tenant_id", "account_id"],
      "additionalProperties": false
    },
    "environment": { "type": "string", "enum": ["test", "live"] },
    "quote_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "quote_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "state": { "type": "string", "const": "queued" } },
          "required": ["state"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": { "type": "string", "const": "running" },
            "attempt": {
              "type": "object",
              "properties": {
                "attempt_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "epoch": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "supervisor_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "started_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                }
              },
              "required": [
                "attempt_id",
                "epoch",
                "supervisor_id",
                "started_at"
              ],
              "additionalProperties": false
            }
          },
          "required": ["state", "attempt"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": { "type": "string", "const": "cancel_requested" },
            "attempt": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "attempt_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "epoch": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "supervisor_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "started_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                    }
                  },
                  "required": [
                    "attempt_id",
                    "epoch",
                    "supervisor_id",
                    "started_at"
                  ],
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            }
          },
          "required": ["state", "attempt"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": { "type": "string", "const": "terminal" },
            "outcome": {
              "type": "string",
              "enum": [
                "completed",
                "rejected_input",
                "timed_out",
                "cancelled",
                "platform_failed"
              ]
            },
            "attempt": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "attempt_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "epoch": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "supervisor_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "started_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                    }
                  },
                  "required": [
                    "attempt_id",
                    "epoch",
                    "supervisor_id",
                    "started_at"
                  ],
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            },
            "completed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "result_sha256": {
              "anyOf": [
                { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                { "type": "null" }
              ]
            }
          },
          "required": [
            "state",
            "outcome",
            "attempt",
            "completed_at",
            "result_sha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "cleanup": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": ["unknown", "pending", "unconfirmed"]
            }
          },
          "required": ["state"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": { "type": "string", "const": "confirmed" },
            "evidence_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "confirmed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            }
          },
          "required": ["state", "evidence_sha256", "confirmed_at"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": { "type": "string", "const": "not_required" },
            "never_started_evidence_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["state", "never_started_evidence_sha256"],
          "additionalProperties": false
        }
      ]
    },
    "accounting": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": { "type": "string", "enum": ["held", "pending"] },
            "reserved_micro_usd": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,29})$"
            }
          },
          "required": ["state", "reserved_micro_usd"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": { "type": "string", "const": "settled" },
            "reserved_micro_usd": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,29})$"
            },
            "actual_micro_usd": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,29})$"
            },
            "usage_event_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "settled_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            }
          },
          "required": [
            "state",
            "reserved_micro_usd",
            "actual_micro_usd",
            "usage_event_id",
            "receipt_sha256",
            "settled_at"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "inspection_id",
    "owner",
    "environment",
    "quote_id",
    "quote_sha256",
    "created_at",
    "execution",
    "cleanup",
    "accounting"
  ],
  "additionalProperties": false
}
