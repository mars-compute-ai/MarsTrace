{
  "$id": "https://marscompute.ai/schemas/xtrace/inspection-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "marscompute.xtrace.inspection-request.v1"
    },
    "cubin_artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "kernel_symbol": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "required": ["schema_version", "cubin_artifact_id"],
  "additionalProperties": false
}
