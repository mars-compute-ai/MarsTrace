{
  "$id": "https://marscompute.ai/schemas/xtrace/error.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "message": { "type": "string", "maxLength": 2000 },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "top_up_url": { "type": "string", "format": "uri" }
      },
      "required": ["code", "message", "correlation_id"],
      "additionalProperties": false
    }
  },
  "required": ["error"],
  "additionalProperties": false
}
